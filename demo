    <script>
        // Toggle mobile dropdown menu logic framework
        function toggleMobileMenu() {
            const menu = document.getElementById('mobile-menu');
            menu.classList.toggle('hidden');
        }

        // Live ROI Playground Simulator Math (Optimized for INR Resource Index)
        function calculateROIMetrics() {
            const team = parseInt(document.getElementById('team-slider').value);
            const hours = parseInt(document.getElementById('hours-slider').value);
            
            document.getElementById('team-val').textContent = `${team} ${team === 1 ? 'member' : 'members'}`;
            document.getElementById('hours-val').textContent = `${hours} hrs`;
            
            // Formula metrics matrix values
            const totalHoursSaved = team * hours * 52; 
            const moneySaved = totalHoursSaved * 75; // Standard Indian Hourly Resource Factor (approx ₹75/hr benchmark)
            
            document.getElementById('saved-hours').textContent = `${totalHoursSaved.toLocaleString()} hrs`;
            document.getElementById('saved-money').textContent = `₹${moneySaved.toLocaleString()}`;
        }

        // Pricing Period Toggle Component Logic Controller
        function togglePricingDuration(mode) {
            const btnMonthly = document.getElementById('toggle-monthly');
            const btnYearly = document.getElementById('toggle-yearly');
            const priceVal = document.getElementById('price-display');
            const periodVal = document.getElementById('period-display');
            
            if(mode === 'yearly') {
                btnMonthly.className = "px-4 py-1.5 text-xs font-bold rounded-lg text-slate-500 hover:text-slate-300 transition-all";
                btnYearly.className = "px-4 py-1.5 text-xs font-bold rounded-lg bg-emerald-500 text-white transition-all";
                priceVal.textContent = "₹3,199";
                periodVal.textContent = "/ month (billed annually)";
            } else {
                btnYearly.className = "px-4 py-1.5 text-xs font-bold rounded-lg text-slate-500 hover:text-slate-300 transition-all";
                btnMonthly.className = "px-4 py-1.5 text-xs font-bold rounded-lg bg-emerald-500 text-white transition-all";
                priceVal.textContent = "₹3,999";
                periodVal.textContent = "/ month";
            }
        }

        // Run baseline setup simulation once on stream loads
        calculateROIMetrics();
    </script>
